{
  "hosting": {
    "site": "majolica",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/telecharger",
        "destination": "https://files.catbox.moe/nv5yzg.zip",
        "type": 302
      },
      {
        "source": "/apk",
        "destination": "https://github.com/laghribsaid87-web/majolica-pos/releases/download/latest/app-debug.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"majolica.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ]
  }
}
